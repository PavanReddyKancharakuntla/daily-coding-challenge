# --- App ---
APP_NAME="Daily Coding Challenge Generator"
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
# Local dev (default): SQLite, file in repo dir.
DATABASE_URL=sqlite:///./dcc.db
# Production (Railway/Render auto-inject DATABASE_URL for Postgres).
# Accepts both postgres:// and postgresql:// — the app normalises it.

# --- CORS (production) ---
# Comma-separated list of frontend origins allowed to call this API.
# Local dev: leave as "*". Production: lock to your Vercel URL.
# Example:
#   CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=*

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Code Execution (Judge0) ---
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# --- Misc ---
TIMEZONE=UTC
