# --- App ---
APP_NAME="Daily Coding Challenge Generator"
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=any-long-random-string-here-doesnt-matter-what
DATABASE_URL=sqlite:///./dcc.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dcc

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Code Execution (Judge0) ---
# Sign up at https://rapidapi.com/judge0-official/api/judge0-ce or self-host
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# --- Misc ---
TIMEZONE=UTC
