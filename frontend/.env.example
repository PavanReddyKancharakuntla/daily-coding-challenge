# Local dev: leave VITE_API_URL unset.
# All /api/* requests are proxied to http://localhost:8000 by vite.config.ts.

# Production (Vercel): set this to the URL of your deployed backend.
# Example after deploying the FastAPI backend to Railway:
#   VITE_API_URL=https://dcc-production.up.railway.app
VITE_API_URL=

# (Optional) Gemini key — only needed if you wire up Gemini features later.
GEMINI_API_KEY=
